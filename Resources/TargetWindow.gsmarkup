<gsmarkup>
  
  <objects>
    <window title="Epeira" id="targetWindow" delegate="#myDelegate">
    
      <view width="1200" height="900">
      
      </view>
    
  </window>
  </objects>
  
  <connectors>
   <outlet source="#NSOwner" target="#targetWindow" key="targetWindow"/>
  </connectors>
  
</gsmarkup>