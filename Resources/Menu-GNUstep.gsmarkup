<?xml version="1.0"?>
<!DOCTYPE gsmarkup>
<!-- Epeira.app: A Web Browser for GNUstep
(c) 2026 - Patrick Cardona
An Agnostep Desktop Application
Under MIT License -->

<gsmarkup>
  <objects>
    <menu type="main">
      <menu title="Info">
        <menuItem title="Info Panel..." keyEquivalent="" action="orderFrontStandardInfoPanel:" />
        <menuItem title="Preferences..." keyEquivalent="" action="openPreferences:" />
        <menuItem title="Help..." keyEquivalent="" action="orderFrontHelpPanel:" />
      </menu>
      <menu title="Favorites">
      <menuItem title="Bookmark Current Page" keyEquivalent="" action="bookmark:" />
      	<menuItem title="New Link" keyEquivalent="" action="newLink:" />
        <menuItem title="Open" keyEquivalent="" action="open:" />
        <menuItem title="Set My HomePage" keyEquivalent="" action="setHomePage:" />
        <menuItem title="Set My SearchPage" keyEquivalent="" action="setSearchPage:" />
      </menu>
      <menu title="Look">
      	<menuItem title="Zoom in" keyEquivalent="" action="zoomIn:" />
      	<menuItem title="Zoom out" keyEquivalent="" action="zoomOut:" />
      	<menuItem title="Toogle Dark Mode" keyEquivalent="" action="toggleDarkMode:" />
      </menu>
      <menu title="History">
      	<menuItem title="Walk back" keyEquivalent="" action="goBack:" />
      	<menuItem title="Walk forward" keyEquivalent="" action="goForward:" />
      </menu>
      <menuItem title="Search on the  Web" keyEquivalent="" action="openSearch:" />
      <menuItem title="Search in this page" keyEquivalent="" action="searchIn:" />
      <menuItem title="Home Page" keyEquivalent="" action="openHomePage:" />
      <menuItem title="Quit" keyEquivalent="q" action="terminate:" />
    </menu>
  </objects>
</gsmarkup>
